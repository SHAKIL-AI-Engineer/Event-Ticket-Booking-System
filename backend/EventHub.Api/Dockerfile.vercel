FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY EventHub.Api.csproj ./
RUN dotnet restore EventHub.Api.csproj
COPY . .
RUN dotnet publish EventHub.Api.csproj -c Release -o /out --no-restore
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /out .
USER $APP_UID
EXPOSE 8080
CMD ["sh", "-c", "exec dotnet EventHub.Api.dll --urls http://0.0.0.0:${PORT:-8080}"]
