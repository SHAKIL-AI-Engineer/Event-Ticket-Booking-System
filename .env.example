# Docker Compose local sandbox. Generate your own values; never commit .env.
MSSQL_SA_PASSWORD=replace-with-a-strong-unique-password-A1!
TICKET_SIGNING_KEY=replace-with-at-least-32-random-characters
RABBITMQ_PASSWORD=replace-with-a-unique-broker-password
GRAFANA_PASSWORD=replace-with-a-unique-dashboard-password
# Use Development only for local demo data / demo accounts.
ASPNETCORE_ENVIRONMENT=Development
PAYMENT_PROVIDER=Sandbox
# For live payments set PAYMENT_PROVIDER=Stripe and supply matching keys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Production requires your HTTPS origin and an initial administrator.
PUBLIC_ORIGIN=
ADMIN_EMAIL=
ADMIN_PASSWORD=
